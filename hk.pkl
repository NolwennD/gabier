amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"

// The formatter is run from its native binary (pinned in mise.toml), not through Gradle, to keep the hook fast.
local openJavaFormat = new Step {
  glob = List("*.java")
  check = "open-java-format --dry-run --set-exit-if-changed {{files}}"
  fix = "open-java-format --replace {{files}}"
}

steps {
  ["open-java-format"] = openJavaFormat
}

// No commit names Claude or Anthropic as a co-author or as its generator (decision of the user, 02-11-2026): an agent
// adds such a trailer out of habit, whatever the attribution setting of Claude Code says.
hooks {
  ["commit-msg"] {
    steps {
      ["no-agent-attribution"] {
        check = #"! grep -qiE '^(co-authored-by:.*(claude|anthropic)|.*generated with \[?claude)' {{commit_msg_file}} || { echo 'commit-msg: remove the Claude attribution line (Co-Authored-By / Generated with Claude Code)' >&2; exit 1; }"#
      }
    }
  }
}
