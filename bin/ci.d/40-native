#!/usr/bin/env -S java --source 25

import java.util.ArrayList;
import java.util.List;

/**
 * Stage {@code native} of the local CI (see {@code bin/ci}). The stage is a script with no {@code .java} extension, which
 * the Java launcher compiles alone, so the checks are in {@code bin/ci.d/native/} (a folder of classes, with {@code
 * Native.java} as its main class): this file starts that program with the arguments it was given, shows its output as it
 * comes and ends with its exit code, so the skip line (exit 77) and {@code --describe} of {@code bin/ci} pass through.
 */
public final class NativeStage {

    public static void main(String[] args) throws Exception {
        String java = ProcessHandle.current().info().command().orElse("java");
        List<String> command = new ArrayList<>(List.of(java, "--source", "25", "bin/ci.d/native/Native.java"));
        command.addAll(List.of(args));
        System.exit(new ProcessBuilder(command).inheritIO().start().waitFor());
    }
}
