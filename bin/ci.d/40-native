#!/usr/bin/env -S java --source 25

import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.concurrent.TimeUnit;
import java.util.regex.Pattern;
import java.util.stream.Stream;

/**
 * Stage {@code native} of the local CI (see {@code bin/ci}): builds the native cli and runs the binary alone, in an
 * empty directory with an empty environment, so that it cannot lean on anything of the checkout: {@code --version}, a
 * usage error reported as a problem object (text, then JSON with {@code --json}) with its exit code, the two output
 * streams kept apart, and then the cli against a real daemon: the installed {@code gabier-daemon} is started on a socket
 * in a temporary directory ({@code GABIER_SOCKET}, never the default path of the user), and {@code status} and {@code
 * stop} are run against it, with no daemon, with a stale socket and with a second daemon; {@code diagnostics} is run
 * against it (with no jdtls to start, so refused as a failed start, which {@code status} then shows) and against the
 * daemon served by the fake language server, {@code :daemon:installFakeServed}, so that no jdtls runs in this stage;
 * {@code rename} is run against the latter too (a dry run, a rename by token, by position and of a type, and refusals),
 * and so are {@code organize-imports} (a dry run, a file organized, a file in order, a refusal), {@code cleanup} (a dry
 * run, a concatenation rewritten into a text block, a file with nothing to clean, refusals) and {@code
 * extract-variable} (a dry run, a variable extracted under the name given, refusals), {@code extract-method} (a dry run,
 * a method extracted under the name given, refusals), {@code extract-constant} (a dry run, a constant extracted under the
 * name given, refusals), {@code extract-field} (a dry run, a field extracted under the name given, refusals), {@code move-type-to-file} (a dry run, a type moved to a file of
 * its own, a refusal), {@code move} (a dry run that makes no folder, classes moved to a new package, refusals), {@code inline} (a dry run, a constant inlined, a refusal) and {@code create} (a dry run, a class
 * created, refusals), {@code references} (the uses of a type, the declaration apart, a symbol nothing uses, refusals), {@code actions} (the fixes of a range, none, as JSON, refusals) and {@code apply-action} (a dry run, an action applied by its title, refusals);
 * a request command with no daemon running starts {@code gabier-daemon} (found on the {@code PATH} or next to the cli;
 * not found, exiting at once), the next request uses it, and {@code stop} ends it. Runs in the current directory, the
 * checkout under verification. It starts and signals only the processes it started, by their handle, and the daemons
 * the cli started, by the pid their {@code status} gave.
 */
public final class Native {

    private static final long TIMEOUT_SECONDS = 60;

    /** The whole problem object of {@code gabier --json --bogus}, member by member, on one line. */
    private static final String USAGE_ERROR_JSON =
            """
            {"type":"urn:gabier:error:usage-error","title":"Usage error",\
            "detail":"Unsupported arguments; run gabier help for the commands, and gabier help <command> for the usage of one",\
            "key":"usage-error","parameters":{"arguments":"--bogus"}}\
            """;

    public static void main(String[] args) throws Exception {
        String skip = appliesGraalvm(Path.of("modules/cli/build.gradle.kts")) ? null : "no native build yet";
        // The native cli is built from the cli and what it requires at run time (protocol, shared) and from the build;
        // the daemon it talks to is built from the daemon and what it requires (core, protocol, shared).
        if (skip == null
                && !reachedBy(
                        "modules/cli/",
                        "modules/protocol/",
                        "modules/shared/",
                        "modules/daemon/",
                        "modules/core/",
                        "build-logic/",
                        "gradle/",
                        "settings.gradle.kts",
                        "build.gradle.kts",
                        "gradle.properties",
                        "bin/ci.d/40-native")) {
            skip = "no changed file reaches the native cli or the daemon (bin/ci --all forces it)";
        }
        if (args.length > 0 && args[0].equals("--describe")) {
            System.out.println("native cli, run alone in an empty directory (version, help, usage error as text and JSON),"
                    + " then against the real daemon (status, stop, no daemon, stale socket, second daemon, SIGTERM, diagnostics with no jdtls to start and with the fake language server, rename, organize-imports, cleanup, extract-variable, extract-method, extract-constant, extract-field, move-type-to-file, move and inline included, the daemon started on demand)");
            if (skip != null) {
                System.out.println("skip: " + skip);
            }
            return;
        }
        if (skip != null) {
            System.out.println("skip: " + skip);
            System.exit(77);
        }
        System.exit(nativeCli(Path.of(".").toAbsolutePath().normalize()));
    }

    /** True when a changed file starts with one of the prefixes, or when the changed files are unknown. */
    private static boolean reachedBy(String... prefixes) {
        String changed = System.getenv("GABIER_CI_CHANGED");
        if (changed == null) {
            return true;
        }
        return changed.lines().anyMatch(path -> Arrays.stream(prefixes).anyMatch(path::startsWith));
    }

    /** The native build exists once the build file of the cli applies the GraalVM plugin. */
    private static boolean appliesGraalvm(Path buildFile) throws IOException {
        return Files.isRegularFile(buildFile) && Files.readString(buildFile).contains("graalvm");
    }

    private static int nativeCli(Path root) throws IOException, InterruptedException {
        int status = run(
                "./gradlew", ":cli:nativeCompile", ":daemon:installDist", ":daemon:installFakeServed", "--console=plain");
        if (status != 0) {
            return status;
        }
        Path binary = root.resolve("modules/cli/build/native/nativeCompile/gabier");
        Path daemon = root.resolve("modules/daemon/build/install/gabier-daemon/bin/gabier-daemon");
        Path fakeDaemon = root.resolve("modules/daemon/build/install/gabier-daemon-fake/bin/gabier-daemon-fake");
        if (!Files.isExecutable(binary)) {
            System.err.println("Missing native binary: " + binary);
            return 1;
        }
        if (!Files.isExecutable(daemon)) {
            System.err.println("Missing installed daemon: " + daemon);
            return 1;
        }
        if (!Files.isExecutable(fakeDaemon)) {
            System.err.println("Missing installed daemon served by the fake language server: " + fakeDaemon);
            return 1;
        }
        Path empty = Files.createTempDirectory("gabier-ci");
        Path copy = empty.resolve("gabier");
        try {
            Files.copy(binary, copy);
            int failures = version(copy, empty) + usageError(copy, empty, false) + usageError(copy, empty, true)
                    + help(copy, empty) + socketOfTheProject(copy, empty);
            failures += new Daemon(copy, daemon, fakeDaemon, empty).check();
            return failures == 0 ? 0 : 1;
        } finally {
            Files.deleteIfExists(copy);
            deleteTree(empty);
        }
    }

    /** What a run of the binary printed on each stream, and its exit code. */
    private record Run(String out, String err, int exit) {}

    /**
     * Runs the binary alone: in the empty directory, with an empty environment but the given variables, the two
     * streams kept apart. It must come back in a minute: a client that hangs is a failure, not a stuck stage.
     */
    private static Run runBinary(Path binary, Path directory, List<String> environment, String... args)
            throws IOException, InterruptedException {
        var command = new ArrayList<String>();
        command.add(binary.toString());
        command.addAll(List.of(args));
        ProcessBuilder builder = new ProcessBuilder(command).directory(directory.toFile());
        builder.environment().clear();
        for (int i = 0; i < environment.size(); i += 2) {
            builder.environment().put(environment.get(i), environment.get(i + 1));
        }
        Path out = Files.createTempFile(directory, "out", ".txt");
        Path err = Files.createTempFile(directory, "err", ".txt");
        builder.redirectOutput(out.toFile()).redirectError(err.toFile());
        Process process = builder.start();
        if (!process.waitFor(TIMEOUT_SECONDS, TimeUnit.SECONDS)) {
            process.destroyForcibly();
            return new Run("", "timed out after " + TIMEOUT_SECONDS + "s: " + String.join(" ", command), -1);
        }
        try {
            return new Run(
                    Files.readString(out, StandardCharsets.UTF_8).strip(),
                    Files.readString(err, StandardCharsets.UTF_8).strip(),
                    process.exitValue());
        } finally {
            Files.delete(out);
            Files.delete(err);
        }
    }

    private static Run runBinary(Path binary, Path directory, String... args) throws IOException, InterruptedException {
        return runBinary(binary, directory, List.of(), args);
    }

    /** 0 when {@code gabier --version} prints the version on the standard output, nothing on the other, and exits 0. */
    private static int version(Path binary, Path directory) throws IOException, InterruptedException {
        Run run = runBinary(binary, directory, "--version");
        System.out.println("gabier --version -> \"" + run.out() + "\" (exit " + run.exit() + ")");

        return run.exit() == 0 && run.out().startsWith("gabier ") && run.err().isEmpty() ? 0 : 1;
    }

    /**
     * 0 when an unknown argument is refused as a problem object on the standard error (one line of text, or a JSON
     * object with {@code --json}) with exit code 2 and nothing on the standard output.
     */
    private static int usageError(Path binary, Path directory, boolean json) throws IOException, InterruptedException {
        Run run = json ? runBinary(binary, directory, "--json", "--bogus") : runBinary(binary, directory, "--bogus");
        System.out.println("gabier " + (json ? "--json " : "") + "--bogus -> stdout \"" + run.out() + "\", stderr \""
                + run.err() + "\" (exit " + run.exit() + ")");
        boolean problem = json
                ? run.err().equals(USAGE_ERROR_JSON)
                : run.err().startsWith("Usage error: ") && run.err().endsWith(")");

        return run.exit() == 2 && run.out().isEmpty() && problem && run.err().lines().count() == 1 ? 0 : 1;
    }

    /**
     * 0 when {@code gabier help}, {@code --help} and {@code -h} list the commands on the standard output with exit 0, and
     * {@code help rename} explains one, in an empty directory with no daemon.
     */
    private static int help(Path binary, Path directory) throws IOException, InterruptedException {
        int failures = 0;
        for (String spelling : List.of("help", "--help", "-h")) {
            Run run = runBinary(binary, directory, spelling);
            System.out.println("gabier " + spelling + " -> " + run.out().lines().count() + " lines (exit " + run.exit() + ")");
            failures += run.exit() == 0 && run.err().isEmpty() && run.out().contains("  extract-variable  ") ? 0 : 1;
        }
        Run one = runBinary(binary, directory, "help", "rename");
        System.out.println("gabier help rename -> " + one.out().lines().count() + " lines (exit " + one.exit() + ")");

        return failures + (one.exit() == 0 && one.err().isEmpty() && one.out().contains("Refusals") ? 0 : 1);
    }

    /**
     * 0 when the native {@code gabier}, with no {@code GABIER_SOCKET}, looks for the socket of the project it is run in:
     * the same one from the root of a worktree and from a subfolder of it, another one for another worktree, each named
     * after its folder, in the runtime directory. {@code status} starts no daemon, and its refusal names the socket.
     */
    private static int socketOfTheProject(Path binary, Path directory) throws IOException, InterruptedException {
        Path runtime = Files.createDirectory(directory.resolve("runtime"));
        Path one = Files.createDirectories(directory.resolve("one-worktree"));
        Files.createFile(one.resolve(".git"));
        Path sub = Files.createDirectories(one.resolve("modules/daemon"));
        Path two = Files.createDirectories(directory.resolve("two-worktree"));
        Files.createFile(two.resolve(".git"));
        List<String> environment = List.of("XDG_RUNTIME_DIR", runtime.toString());
        Pattern named = Pattern.compile("socket=(" + Pattern.quote(runtime.toRealPath() + "/gabier/") + "(\\S+)-[0-9a-f]{8}\\.sock)\\)");

        String[] sockets = new String[3];
        Path[] folders = {one, sub, two};
        String[] names = {"one-worktree", "one-worktree", "two-worktree"};
        int failures = 0;
        for (int i = 0; i < folders.length; i++) {
            Run run = runBinary(binary, folders[i], environment, "status");
            var match = named.matcher(run.err());
            boolean found = run.exit() == 2 && match.find() && match.group(2).equals(names[i]);
            System.out.println("gabier status in " + folders[i].getFileName() + " -> " + run.err() + " (exit " + run.exit() + ")");
            sockets[i] = found ? match.group(1) : "";
            failures += found ? 0 : 1;
        }

        return failures + (!sockets[0].isEmpty() && sockets[0].equals(sockets[1]) && !sockets[0].equals(sockets[2]) ? 0 : 1);
    }

    /** The native cli against the installed daemon, on a socket of its own. */
    private static final class Daemon {

        private static final Pattern STATUS =
                Pattern.compile("gabier-daemon 0\\.1, pid (\\d+), up \\d+s, project \\S+, jdtls not-started");
        private static final Pattern STATUS_JSON = Pattern.compile(
                "\\{\"version\":\"0\\.1\",\"pid\":(\\d+),\"uptimeMillis\":\\d+,\"project\":\"[^\"]+\",\"jdtls\":\"not-started\"\\}");

        /** The status of a daemon the cli started: the project is the folder its script gave. */
        private static final Pattern STARTED_STATUS = Pattern.compile(
                "gabier-daemon 0\\.1, pid (\\d+), up \\d+s, project \\S+-project, jdtls \\w+");

        private final Path cli;
        private final Path daemon;
        private final Path fakeDaemon;
        private final Path directory;
        private final Path socket;
        private final List<Process> started = new ArrayList<>();
        private int failures;

        private Daemon(Path cli, Path daemon, Path fakeDaemon, Path directory) {
            this.cli = cli;
            this.daemon = daemon;
            this.fakeDaemon = fakeDaemon;
            this.directory = directory;
            // The directory is private to the user (a temporary directory is created with mode 700) and short: the
            // path of a socket is limited to 107 bytes.
            this.socket = directory.resolve("gabier.sock");
        }

        /** The number of checks that failed. */
        int check() throws IOException, InterruptedException {
            try {
                noDaemon();
                longPath();
                statusAndStop();
                sigterm();
                secondDaemonAndStaleSocket();
                diagnosticsWithNoJdtls();
                startsTheDaemonOnDemand();
                diagnosticsWithTheFakeServer();
                renameWithTheFakeServer();
                organizeImportsWithTheFakeServer();
                cleanupWithTheFakeServer();
                extractVariableWithTheFakeServer();
                extractMethodWithTheFakeServer();
                extractConstantWithTheFakeServer();
                extractFieldWithTheFakeServer();
                moveTypeToFileWithTheFakeServer();
                moveToAPackageWithTheFakeServer();
                inlineWithTheFakeServer();
                createWithTheFakeServer();
                referencesWithTheFakeServer();
                actionsWithTheFakeServer();
                fakeServedRefusesAFolderThatIsNotEmpty();
            } finally {
                for (Process process : started) {
                    if (process.isAlive()) {
                        process.destroyForcibly();
                    }
                }
            }
            return failures;
        }

        private void expect(boolean condition, String what) {
            System.out.println((condition ? "ok: " : "FAILED: ") + what);
            if (!condition) {
                failures++;
            }
        }

        private Run gabier(String... args) throws IOException, InterruptedException {
            Run run = runBinary(cli, directory, List.of("GABIER_SOCKET", socket.toString()), args);
            System.out.println("gabier " + String.join(" ", args) + " -> stdout \"" + run.out() + "\", stderr \""
                    + run.err() + "\" (exit " + run.exit() + ")");
            return run;
        }

        /** The cli with these variables only (pairs of name and value) and the socket of the stage. */
        private Run gabierWith(Path binary, List<String> environment, String... args)
                throws IOException, InterruptedException {
            var all = new ArrayList<>(List.of("GABIER_SOCKET", socket.toString()));
            all.addAll(environment);
            Run run = runBinary(binary, directory, all, args);
            System.out.println("gabier " + String.join(" ", args) + " -> stdout \"" + run.out() + "\", stderr \""
                    + run.err() + "\" (exit " + run.exit() + ")");
            return run;
        }

        /**
         * Starts the installed daemon, and waits until it says it is listening (a stale socket file may already be
         * there, so the file does not tell). Null when it did not start.
         */
        private Process startDaemon() throws IOException, InterruptedException {
            return startDaemon(daemon);
        }

        /** Starts a daemon of the build (the installed one or the one served by the fake), as above. */
        private Process startDaemon(Path executable, String... args) throws IOException, InterruptedException {
            var command = new ArrayList<String>();
            command.add(executable.toString());
            command.addAll(List.of(args));
            ProcessBuilder builder = new ProcessBuilder(command).directory(directory.toFile());
            builder.environment().put("GABIER_SOCKET", socket.toString());
            // The start script runs the java of JAVA_HOME: the JDK that runs this stage.
            builder.environment().put("JAVA_HOME", System.getProperty("java.home"));
            // No jdtls in this stage, whatever the environment of the CI run holds: the launcher is a file that is not there.
            builder.environment().put("GABIER_JDTLS", directory.resolve("no-jdtls").toString());
            Path log = Files.createTempFile(directory, "daemon", ".log");
            builder.redirectErrorStream(true).redirectOutput(log.toFile());
            Process process = builder.start();
            started.add(process);
            for (int attempt = 0; attempt < TIMEOUT_SECONDS * 20; attempt++) {
                if (Files.readString(log).contains(" listening on ")) {
                    return process;
                }
                if (!process.isAlive()) {
                    break;
                }
                Thread.sleep(50);
            }
            System.out.println("the daemon did not start: " + Files.readString(log));
            process.destroyForcibly();
            return null;
        }

        /** The daemon ends by itself, in a minute at most. */
        private boolean ends(Process process) throws InterruptedException {
            return process.waitFor(TIMEOUT_SECONDS, TimeUnit.SECONDS);
        }

        private void noDaemon() throws IOException, InterruptedException {
            for (String command : List.of("status", "stop")) {
                Run run = gabier(command);
                expect(
                        run.exit() == 2
                                && run.out().isEmpty()
                                && run.err().startsWith("Daemon not running: ")
                                && run.err().contains("(daemon-not-running; "),
                        "gabier " + command + " with no daemon says so, exit 2, and does not hang");
            }
        }

        private void longPath() throws IOException, InterruptedException {
            String tooLong = "/" + "a".repeat(119);
            Run run = runBinary(cli, directory, List.of("GABIER_SOCKET", tooLong), "status");
            System.out.println("gabier status (path of 120 bytes) -> stderr \"" + run.err() + "\" (exit " + run.exit() + ")");
            expect(
                    run.exit() == 2 && run.err().contains("(socket-path-too-long; "),
                    "a socket path over 107 bytes is refused before any connection, exit 2");
        }

        private void statusAndStop() throws IOException, InterruptedException {
            Process process = startDaemon();
            if (process == null) {
                failures++;
                return;
            }
            Run status = gabier("status");
            var text = STATUS.matcher(status.out());
            expect(
                    status.exit() == 0 && text.matches() && text.group(1).equals(String.valueOf(process.pid())),
                    "gabier status reports the pid of the process that was started (the script execs the JVM)");
            Run json = gabier("--json", "status");
            var jsonMatch = STATUS_JSON.matcher(json.out());
            expect(
                    json.exit() == 0 && jsonMatch.matches() && jsonMatch.group(1).equals(String.valueOf(process.pid())),
                    "gabier --json status gives the result as JSON");
            expect(
                    posix(socket).equals("rw-------") && posix(directory).equals("rwx------"),
                    "the socket and its folder are private to the user");

            Run stop = gabier("stop");
            expect(
                    stop.exit() == 0 && stop.out().equals("gabier-daemon stopped"),
                    "gabier stop exits 0 and says the daemon stopped");
            expect(
                    ends(process) && process.exitValue() == 0,
                    "the daemon process has exited with status 0 once gabier stop returned");
            expect(ProcessHandle.of(process.pid()).isEmpty(), "no process of the daemon is left");
            expect(!Files.exists(socket), "the socket is removed by stop");
            Run after = gabier("status");
            expect(after.exit() == 2 && after.err().contains("(daemon-not-running; "), "no daemon after stop");
        }

        private void sigterm() throws IOException, InterruptedException {
            Process process = startDaemon();
            if (process == null) {
                failures++;
                return;
            }
            process.destroy(); // SIGTERM, to the process we started and to nothing else
            expect(ends(process), "the daemon ends on SIGTERM");
            expect(!Files.exists(socket), "the socket is removed on SIGTERM");
            expect(ProcessHandle.of(process.pid()).isEmpty(), "no process of the daemon is left after SIGTERM");
        }

        private void secondDaemonAndStaleSocket() throws IOException, InterruptedException {
            Process first = startDaemon();
            if (first == null) {
                failures++;
                return;
            }
            // A second daemon on the same socket refuses to start, and the first one is not disturbed.
            Path log = Files.createTempFile(directory, "second", ".log");
            ProcessBuilder builder = new ProcessBuilder(daemon.toString()).directory(directory.toFile());
            builder.environment().put("GABIER_SOCKET", socket.toString());
            builder.environment().put("JAVA_HOME", System.getProperty("java.home"));
            Process second = builder.redirectErrorStream(true).redirectOutput(log.toFile()).start();
            started.add(second);
            boolean ended = ends(second);
            String output = Files.readString(log);
            System.out.println("second daemon -> " + output.strip() + " (exit " + (ended ? second.exitValue() : -1) + ")");
            expect(
                    ended && second.exitValue() == 2 && output.contains("(daemon-already-running; "),
                    "a second daemon refuses to start while one answers, exit 2");
            expect(gabier("status").exit() == 0, "the first daemon still answers");

            // A daemon that was killed leaves its socket file: the next one removes it.
            first.destroyForcibly();
            ends(first);
            expect(Files.exists(socket), "a killed daemon leaves its socket file behind");
            Process third = startDaemon();
            if (third == null) {
                failures++;
                return;
            }
            Run status = gabier("status");
            expect(
                    status.exit() == 0 && status.out().contains("pid " + third.pid()),
                    "a daemon removes a stale socket and serves on it");
            gabier("stop");
            expect(ends(third), "the third daemon stops");
        }

        /**
         * The daemon starts jdtls at the first request that needs it, and says in a problem object why it cannot when
         * the launcher is not there; {@code status} then shows the failure and the project, and still starts nothing.
         */
        private void diagnosticsWithNoJdtls() throws IOException, InterruptedException {
            Process process = startDaemon();
            if (process == null) {
                failures++;
                return;
            }
            Run run = gabier("diagnostics", "Main.java");
            expect(
                    run.exit() == 1
                            && run.out().isEmpty()
                            && run.err().startsWith("Jdtls start failed: ")
                            && run.err().contains("no-jdtls")
                            && run.err().contains("(jdtls-start-failed; project="),
                    "gabier diagnostics against the installed daemon, whose jdtls cannot start, is a problem object"
                            + " that says why, exit 1");
            Run status = gabier("status");
            expect(
                    status.exit() == 0
                            && status.out().contains(", jdtls failed (jdtls did not start: ")
                            && status.out().contains("no-jdtls"),
                    "gabier status shows the failed start and why");
            Run again = gabier("diagnostics", "Main.java");
            expect(again.exit() == 1 && again.err().contains("(jdtls-start-failed; "), "the next request tries again");
            gabier("stop");
            expect(ends(process), "the daemon stops");
        }

        /**
         * The commands of the catalogue against the installed daemon served by the fake language server, which answers
         * what the contract scenarios say jdtls answers: no jdtls in this stage. The file is given relative to the
         * directory the cli runs in, as a user types it.
         */
        private void diagnosticsWithTheFakeServer() throws IOException, InterruptedException {
            Path project = directory.resolve("project");
            Process process = startDaemon(fakeDaemon, project.toString());
            if (process == null) {
                failures++;
                return;
            }
            String broken = "project/src/main/java/demo/Broken.java";
            String message = "Type mismatch: cannot convert from String to int";
            Run error = gabier("diagnostics", broken);
            expect(
                    error.exit() == 0 && error.err().isEmpty() && error.out().equals(broken + ":5:16: error: " + message),
                    "gabier diagnostics of a file with an error prints it, positions from 1, and exits 0");
            Run warning = gabier("diagnostics", "project/src/main/java/demo/Sloppy.java");
            expect(
                    warning.exit() == 0
                            && warning.out()
                                    .equals("project/src/main/java/demo/Sloppy.java:5:13: warning:"
                                            + " The value of the local variable unused is not used"),
                    "gabier diagnostics of a file with a warning prints it and exits 0");
            Run clean = gabier("diagnostics", "project/src/main/java/demo/Main.java");
            expect(clean.exit() == 0 && clean.out().isEmpty() && clean.err().isEmpty(), "a clean file prints nothing");
            Run json = gabier("--json", "diagnostics", broken);
            expect(
                    json.exit() == 0
                            && json.out()
                                    .equals("{\"diagnostics\":[{\"severity\":\"error\",\"line\":4,\"column\":15,"
                                            + "\"message\":\"" + message + "\"}]}"),
                    "gabier --json diagnostics gives the result with the positions from 0");
            Run outside = gabier("diagnostics", "outside/Elsewhere.java");
            expect(
