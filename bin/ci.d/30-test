#!/usr/bin/env -S java --source 25

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.List;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.util.stream.Stream;

/**
 * Stage {@code test} of the local CI (see {@code bin/ci}): the tests and the gates (coverage, architecture), from a
 * clean test state so that a cached result never passes for a fresh one, then the test counts per project, read from
 * the XML reports. Runs in the current directory, the checkout under verification.
 */
public final class Test {

    private static final Pattern TEST_COUNTS =
            Pattern.compile("tests=\"(\\d+)\" skipped=\"(\\d+)\" failures=\"(\\d+)\" errors=\"(\\d+)\"");

    public static void main(String[] args) throws Exception {
        if (args.length > 0 && args[0].equals("--describe")) {
            System.out.println("tests and gates (coverage, architecture), from a clean test state");
            return;
        }
        int status = run("./gradlew", "cleanTest", "check", "--console=plain");
        printTestCounts(Path.of("."));
        System.exit(status);
    }

    /** What the XML reports say, per project (every module and the architecture tests). */
    private static void printTestCounts(Path root) throws IOException {
        System.out.println("-- test counts (from <project>/build/test-results) --");
        List<Path> projects = new ArrayList<>();
        Path modules = root.resolve("modules");
        if (Files.isDirectory(modules)) {
            try (Stream<Path> moduleDirs = Files.list(modules)) {
                projects.addAll(moduleDirs.sorted().toList());
            }
        }
        Path architecture = root.resolve("architecture");
        if (Files.isDirectory(architecture)) {
            projects.add(architecture);
        }
        for (Path project : projects) {
            Path results = project.resolve("build/test-results/test");
            if (!Files.isDirectory(results)) {
                System.out.printf("%-12s no test results%n", project.getFileName());
                continue;
            }
            int tests = 0;
            int skipped = 0;
            int failures = 0;
            try (Stream<Path> files = Files.list(results)) {
                for (Path xml : files.filter(p -> p.toString().endsWith(".xml")).toList()) {
                    Matcher matcher = TEST_COUNTS.matcher(Files.readString(xml));
                    if (matcher.find()) {
                        tests += Integer.parseInt(matcher.group(1));
                        skipped += Integer.parseInt(matcher.group(2));
                        failures += Integer.parseInt(matcher.group(3)) + Integer.parseInt(matcher.group(4));
                    }
                }
            }
            System.out.printf(
                    "%-12s tests=%d skipped=%d failures=%d%n", project.getFileName(), tests, skipped, failures);
        }
    }

    private static int run(String... command) throws InterruptedException {
        System.out.println("$ " + String.join(" ", command));
        try {
            return new ProcessBuilder(command).inheritIO().start().waitFor();
        } catch (IOException e) {
            System.err.println("Cannot run " + command[0] + ": " + e.getMessage());
            return 127;
        }
    }
}
