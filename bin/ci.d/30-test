#!/usr/bin/env -S java --source 25

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.List;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.util.stream.Stream;

/**
 * Stage {@code test} of the local CI (see {@code bin/ci}): the tests and the gates (coverage, architecture, Checkstyle), from a
 * clean test state so that a cached result never passes for a fresh one (the unit tests, which need no jdtls), then
 * the test counts per project and test task, read from the XML reports. A project that has test sources but reports
 * no test fails the stage: a green build that ran nothing is not a pass. Runs in the current directory, the checkout
 * under verification.
 */
public final class Test {

    private static final Pattern TEST_COUNTS =
            Pattern.compile("tests=\"(\\d+)\" skipped=\"(\\d+)\" failures=\"(\\d+)\" errors=\"(\\d+)\"");

    public static void main(String[] args) throws Exception {
        if (args.length > 0 && args[0].equals("--describe")) {
            System.out.println("tests and gates (coverage, architecture, Checkstyle), from a clean test state");
            return;
        }
        int status = run("./gradlew", "cleanTest", "check", "--console=plain");
        List<String> silent = printTestCounts(Path.of("."));
        if (!silent.isEmpty()) {
            System.err.println("These projects have test sources but ran no test: " + String.join(", ", silent));
        }
        System.exit(status != 0 ? status : silent.isEmpty() ? 0 : 1);
    }

    /**
     * What the XML reports say, per project (every module and the architecture tests).
     *
     * @return the projects that have unit test sources and ran no unit test
     */
    private static List<String> printTestCounts(Path root) throws IOException {
        System.out.println("-- test counts (from <project>/build/test-results) --");
        List<String> silent = new ArrayList<>();
        List<Path> projects = new ArrayList<>();
        Path modules = root.resolve("modules");
        if (Files.isDirectory(modules)) {
            try (Stream<Path> moduleDirs = Files.list(modules)) {
                projects.addAll(moduleDirs.sorted().toList());
            }
        }
        Path architecture = root.resolve("architecture");
        if (Files.isDirectory(architecture)) {
            projects.add(architecture);
        }
        for (Path project : projects) {
            Path resultsRoot = project.resolve("build/test-results");
            List<Path> tasks = new ArrayList<>();
            if (Files.isDirectory(resultsRoot)) {
                try (Stream<Path> taskDirs = Files.list(resultsRoot)) {
                    // jdtlsProbe is the jdtls stage's: its results, stale or not, are not the ones of this stage.
                    // quickProbeTest is a task that no longer exists: what an older run left is not a result either.
                    tasks.addAll(taskDirs.filter(Files::isDirectory)
                            .filter(dir ->
                                    !List.of("jdtlsProbe", "quickProbeTest").contains(dir.getFileName().toString()))
                            .sorted().toList());
                }
            }
            boolean hasTests = hasJavaFiles(project.resolve("src/test/java"));
            if (tasks.isEmpty()) {
                System.out.printf("%-12s no test results%n", project.getFileName());
                if (hasTests) {
                    silent.add(project.getFileName().toString());
                }
                continue;
            }
            for (Path results : tasks) {
                int tests = 0;
                int skipped = 0;
                int failures = 0;
                try (Stream<Path> files = Files.list(results)) {
                    for (Path xml : files.filter(p -> p.toString().endsWith(".xml")).toList()) {
                        Matcher matcher = TEST_COUNTS.matcher(Files.readString(xml));
                        if (matcher.find()) {
                            tests += Integer.parseInt(matcher.group(1));
                            skipped += Integer.parseInt(matcher.group(2));
                            failures += Integer.parseInt(matcher.group(3)) + Integer.parseInt(matcher.group(4));
                        }
                    }
                }
                String task = results.getFileName().toString();
                String name = project.getFileName() + (task.equals("test") ? "" : " " + task);
                System.out.printf("%-26s tests=%d skipped=%d failures=%d%n", name, tests, skipped, failures);
                if (task.equals("test") && hasTests && tests == 0) {
                    silent.add(project.getFileName().toString());
                }
            }
        }
        return silent;
    }

    private static boolean hasJavaFiles(Path sources) throws IOException {
        if (!Files.isDirectory(sources)) {
            return false;
        }
        try (Stream<Path> files = Files.walk(sources)) {
            return files.anyMatch(file -> file.toString().endsWith(".java"));
        }
    }

    private static int run(String... command) throws InterruptedException {
        System.out.println("$ " + String.join(" ", command));
        try {
            return new ProcessBuilder(command).inheritIO().start().waitFor();
        } catch (IOException e) {
            System.err.println("Cannot run " + command[0] + ": " + e.getMessage());
            return 127;
        }
    }
}
