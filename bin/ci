#!/usr/bin/env -S java --source 25

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.time.Duration;
import java.util.ArrayList;
import java.util.List;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.util.stream.Stream;

/**
 * Local CI for gabier, a JEP 330 single-file program: run it as {@code bin/ci}, no build tool involved.
 *
 * <p>It runs the stages found in {@code bin/ci.d/} of the checkout it verifies, in the order of their names, and stops at
 * the first failure, like a pipeline. A stage is an executable JEP 330 file named {@code NN-name} (for instance
 * {@code 30-test}): adding a stage is adding a file, nothing here changes. Its contract:
 *
 * <ul>
 *   <li>{@code <stage>}: run, with the checkout as the current directory. Exit 0 = passed, 77 = does not apply yet (it
 *       prints {@code skip: <reason>} first), anything else = failed. Its output is shown as it comes;
 *   <li>{@code <stage> --describe}: print one line saying what it does, then {@code skip: <reason>} when it would not
 *       apply.
 * </ul>
 *
 * A skipped stage is reported as skipped with its reason: it is never a green one. The stages are started with the same
 * java as this program, so a mise shim on the PATH is never used.
 *
 * <p>The slow stages ({@code native}, {@code jdtls}) are kept off the working path: {@code --fast} leaves them out, to be
 * used while working, and the full run is made once when the work is ready. A stage may also skip itself when nothing
 * that changed can reach it: the list of the changed files (against the merge base with {@code main}, working tree and
 * untracked files included) is given to the stages in {@code GABIER_CI_CHANGED}, one path per line, and is absent when it
 * cannot be known (the checkout is {@code main} itself, clean) or with {@code --all}, so that everything then runs.
 *
 * <p>Usage: {@code bin/ci [--list] [--fast] [--all] [--stage <name>]... [<directory>]}. The directory is the checkout to
 * verify (a ticket worktree, for instance); it defaults to the current one.
 */
public final class Ci {

    private static final int SKIPPED = 77;
    private static final Pattern STAGE_FILE = Pattern.compile("(\\d+)-(.+)");
    private static final Pattern SKIP_LINE = Pattern.compile("skip: (.*)");

    /** The stages that take minutes: {@code --fast} leaves them out. */
    private static final List<String> SLOW = List.of("native", "jdtls");

    /** The changed files given to the stages, or null when unknown. */
    private static String changed;

    private record Stage(String name, Path file) {}

    private record Outcome(String stage, String status, Duration duration) {}

    public static void main(String[] args) throws Exception {
        List<String> wanted = new ArrayList<>();
        boolean list = false;
        boolean fast = false;
        boolean all = false;
        Path root = Path.of(".");
        for (int i = 0; i < args.length; i++) {
            switch (args[i]) {
                case "--list" -> list = true;
                case "--fast" -> fast = true;
                case "--all" -> all = true;
                case "--stage" -> wanted.add(args[++i]);
                default -> root = Path.of(args[i]);
            }
        }
        root = root.toAbsolutePath().normalize();
        changed = all ? null : changedFiles(root);

        List<Stage> stages = stages(root);
        if (stages.isEmpty()) {
            System.err.println("No stage in " + root.resolve("bin/ci.d") + ".");
            System.exit(2);
        }
        for (String name : wanted) {
            if (stages.stream().noneMatch(stage -> stage.name().equals(name))) {
                System.err.println("Unknown stage: " + name + ". Run bin/ci --list.");
                System.exit(2);
            }
        }
        if (list) {
            for (Stage stage : stages) {
                List<String> lines = capture(root, stage, "--describe").lines();
                String skip = lines.stream().skip(1).map(Ci::skipReason).filter(r -> r != null).findFirst().orElse(null);
                System.out.printf(
                        "%-12s %s%s%n",
                        stage.name(),
                        lines.isEmpty() ? "" : lines.get(0),
                        skip == null ? "" : "  [skipped: " + skip + "]");
            }
            return;
        }

        List<Outcome> outcomes = new ArrayList<>();
        boolean failed = false;
        int index = 0;
        for (Stage stage : stages) {
            index++;
            if (!wanted.isEmpty() && !wanted.contains(stage.name())) {
                continue;
            }
            if (failed) {
                outcomes.add(new Outcome(stage.name(), "not run", Duration.ZERO));
                continue;
            }
            if (fast && SLOW.contains(stage.name())) {
                outcomes.add(new Outcome(stage.name(), "skipped: --fast (run bin/ci without it when ready)", Duration.ZERO));
                continue;
            }
            System.out.printf("%n== [%d/%d] %s ==%n", index, stages.size(), stage.name());
            long start = System.nanoTime();
            Run run = run(root, stage);
            Duration duration = Duration.ofNanos(System.nanoTime() - start);
            if (run.status() == SKIPPED) {
                String reason = run.skipReason() == null ? "no reason given" : run.skipReason();
                outcomes.add(new Outcome(stage.name(), "skipped: " + reason, Duration.ZERO));
                continue;
            }
            failed = run.status() != 0;
            outcomes.add(
                    new Outcome(stage.name(), failed ? "FAILED (exit " + run.status() + ")" : "passed", duration));
        }

        System.out.printf("%n== Summary (%s) ==%n", root);
        outcomes.forEach(outcome -> System.out.printf(
                "%-12s %s%s%n",
                outcome.stage(),
                outcome.status(),
                outcome.duration().isZero() ? "" : " in " + outcome.duration().toSeconds() + "s"));
        System.exit(failed ? 1 : 0);
    }

    /**
     * The files that differ from the merge base with {@code main}, working tree and untracked files included, or null
     * when that cannot tell anything: no {@code main}, no Git, or the checkout is {@code main} itself and clean.
     */
    private static String changedFiles(Path root) {
        try {
            String head = git(root, "rev-parse", "HEAD");
            String base = git(root, "merge-base", "main", "HEAD");
            if (head == null || base == null) {
                return null;
            }
            List<String> paths = new ArrayList<>();
            for (String output : new String[] {
                git(root, "diff", "--name-only", base), git(root, "ls-files", "--others", "--exclude-standard")
            }) {
                if (output == null) {
                    return null;
                }
                output.lines().filter(line -> !line.isBlank()).forEach(paths::add);
            }
            return base.equals(head) && paths.isEmpty() ? null : String.join("\n", paths);
        } catch (IOException | InterruptedException e) {
            return null;
        }
    }

    /** The output of a Git command, or null when it fails. */
    private static String git(Path root, String... arguments) throws IOException, InterruptedException {
        List<String> command = new ArrayList<>(List.of("git", "-C", root.toString()));
        command.addAll(List.of(arguments));
        Process process = new ProcessBuilder(command).redirectErrorStream(true).start();
        String output = new String(process.getInputStream().readAllBytes(), StandardCharsets.UTF_8).strip();
        return process.waitFor() == 0 ? output : null;
    }

    /** The executable files of {@code bin/ci.d/}, named {@code NN-name}, in the order of their names. */
    private static List<Stage> stages(Path root) throws IOException {
        Path directory = root.resolve("bin/ci.d");
        if (!Files.isDirectory(directory)) {
            return List.of();
        }
        try (Stream<Path> files = Files.list(directory)) {
            return files.filter(Files::isRegularFile)
                    .filter(Files::isExecutable)
                    .sorted()
                    .flatMap(file -> {
                        Matcher matcher = STAGE_FILE.matcher(file.getFileName().toString());
                        return matcher.matches() ? Stream.of(new Stage(matcher.group(2), file)) : Stream.empty();
                    })
                    .toList();
        }
    }

    private record Run(int status, String skipReason) {}

    private record Captured(int status, List<String> lines) {}

    /** Runs a stage, showing its output as it comes and remembering the reason it gave to skip. */
    private static Run run(Path root, Stage stage, String... arguments) throws IOException, InterruptedException {
        Process process = start(root, stage, arguments);
        String skipReason = null;
        try (BufferedReader reader =
                new BufferedReader(new InputStreamReader(process.getInputStream(), StandardCharsets.UTF_8))) {
            String line;
            while ((line = reader.readLine()) != null) {
                System.out.println(line);
                String reason = skipReason(line);
                if (reason != null) {
                    skipReason = reason;
                }
            }
        }
        return new Run(process.waitFor(), skipReason);
    }

    /** Runs a stage and keeps its output instead of showing it. */
    private static Captured capture(Path root, Stage stage, String... arguments)
            throws IOException, InterruptedException {
        Process process = start(root, stage, arguments);
        List<String> lines;
        try (BufferedReader reader =
                new BufferedReader(new InputStreamReader(process.getInputStream(), StandardCharsets.UTF_8))) {
            lines = reader.lines().toList();
        }
        return new Captured(process.waitFor(), lines);
    }

    private static Process start(Path root, Stage stage, String... arguments) throws IOException {
        String java = ProcessHandle.current().info().command().orElse("java");
        List<String> command = new ArrayList<>(List.of(java, "--source", "25", stage.file().toString()));
        command.addAll(List.of(arguments));
        ProcessBuilder builder =
                new ProcessBuilder(command).directory(root.toFile()).redirectErrorStream(true);
        if (changed != null) {
            builder.environment().put("GABIER_CI_CHANGED", changed);
        }
        return builder.start();
    }

    private static String skipReason(String line) {
        Matcher matcher = SKIP_LINE.matcher(line);
        return matcher.matches() ? matcher.group(1) : null;
    }
}
